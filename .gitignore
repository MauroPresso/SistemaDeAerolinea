# Compilados Java
*.class

# Carpeta de salida de compilacion
/bin/

# Datos serializados generados por el programa
/data/*.dat

# Base H2 generada por el modo ORM
/data/*.mv.db
/data/*.trace.db
/data/*.lock.db

# Configuracion local de VS Code
.vscode/

# Archivos temporales del sistema
.DS_Store
Thumbs.db

# Salida estandar de Maven
target/

# Doxygen generated output
/docs/doxygen/html/
/docs/doxygen/latex/
/docs/doxygen/xml/
/docs/doxygen/doxygen-warnings.log

# Bases H2 generadas en cualquier laboratorio
**/data/*.mv.db
**/data/*.trace.db
**/data/*.lock.db

# Backups locales
*.backup